{
  "name": "@mapconductor/js-vectorstyle",
  "version": "0.3.0",
  "description": "Declarative adjustments to a MapLibre style, as a MapConductor map's appearance",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/fetch-vector-assets.mjs",
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "node --test \"test/*.test.mjs\"",
    "pretest": "npm run build"
  },
  "keywords": [
    "maps",
    "maplibre",
    "style",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapConductor/js-vectorstyle.git"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
